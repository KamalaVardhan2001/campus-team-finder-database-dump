CREATE RANGE INDEX FOR (n:Application) ON (n.status);
CREATE RANGE INDEX FOR (n:Project) ON (n.status);
CREATE RANGE INDEX FOR (n:Student) ON (n.email);
CREATE CONSTRAINT application_id_unique FOR (node:Application) REQUIRE (node.applicationId) IS UNIQUE;
CREATE CONSTRAINT project_id_unique FOR (node:Project) REQUIRE (node.projectId) IS UNIQUE;
CREATE CONSTRAINT skill_name_unique FOR (node:Skill) REQUIRE (node.name) IS UNIQUE;
CREATE CONSTRAINT student_id_unique FOR (node:Student) REQUIRE (node.studentId) IS UNIQUE;
